{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with daily nutritional targets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "targetCalories": { "type": "number" },
        "targetProtein": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "targetCalories", "targetProtein"]
    },
    "Meal": {
      "title": "Meal",
      "description": "Logged meal with calories, protein, and items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "mealType": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "notes": { "type": "string" },
        "imageUrl": { "type": "string" },
        "aiConfidence": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "calories", "protein", "mealType", "date", "time"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and target calorie/protein settings"
    },
    "/users/{userId}/meals/{mealId}": {
      "schema": "Meal",
      "description": "Meals logged by the authenticated user"
    }
  }
}
